# Frontend Auth0 SPA config — public browser values, not secrets.
# Copy to `frontend/.env.local` and adjust if needed.
# .env.local is gitignored. Never commit real credentials to .env.example.

VITE_AUTH0_DOMAIN=example.auth0.test
VITE_AUTH0_CLIENT_ID=example-spa-client-id
VITE_AUTH0_AUDIENCE=https://ambient-weather-dashboard-api

# Leave empty locally — the Vite dev server proxies /api and /hubs to http://localhost:5080.
# Set to the deployed API URL in production environments.
VITE_API_BASE_URL=

# Optional: Application Insights connection string.
# Leave empty to disable frontend telemetry (the default for local development).
# Set to your Azure Application Insights connection string in staging/production.
# Never put this in the committed .env.example — set it in your deployment environment.
VITE_APPLICATIONINSIGHTS_CONNECTION_STRING=

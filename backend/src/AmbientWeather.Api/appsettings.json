{
  "AppName": "Ambient Weather Dashboard",
  "AppSlug": "AmbientWeatherDashboard",
  "UserAgent": {
    "ProductName": "AmbientWeatherDashboard"
  },
  "AmbientApi": {
    "BaseUrl": "https://api.ambientweather.net/v1/",
    "RateLimits": {
      "UserApiKeyIntervalMilliseconds": 1000,
      "ApplicationKeyIntervalMilliseconds": 334
    },
    "Resilience": {
      "MaxRetryAttempts": 3,
      "BaseRetryDelayMilliseconds": 500,
      "CircuitBreakerFailureThreshold": 5,
      "CircuitBreakerBreakDurationSeconds": 30
    }
  },
  "Redis": {
    "InstanceName": "AmbientWeatherDashboard:"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient.AmbientWeatherRest": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Features": {
    "AmbientOpenApiEnabled": true
  }
}

{
  "_comment": "Copy to appsettings.json or use dotnet user-secrets for local development. Never commit real secrets.",

  "AppName": "Ambient Weather Dashboard",

  "_allowedHostsComment": "Use * only for local Development. Staging/Production must list concrete hostnames, e.g. dashboard.example.com;api.example.com.",
  "AllowedHosts": "*",

  "UserAgent": {
    "ProductName": "AmbientWeatherDashboard",
    "Contact": "contact@example.com"
  },

  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=AmbientWeatherDB;Username=postgres;Password=change-me-local-only",
    "Redis": "localhost:6379"
  },

  "Authentication": {
    "Authority": "https://{your-auth0-domain}/",
    "Audience": "https://ambient-weather-dashboard-api"
  },

  "AmbientApi": {
    "BaseUrl": "https://api.ambientweather.net/v1/",
    "Resilience": {
      "MaxRetryAttempts": 3,
      "BaseRetryDelayMilliseconds": 500,
      "CircuitBreakerFailureThreshold": 5,
      "CircuitBreakerBreakDurationSeconds": 30
    },
    "RateLimits": {
      "UserApiKeyIntervalMilliseconds": 1000,
      "ApplicationKeyIntervalMilliseconds": 334
    }
  },

  "Features": {
    "AmbientOpenApiEnabled": false
  },

  "DataProtection": {
    "KeyRingPath": ""
  },

  "Redis": {
    "InstanceName": "AmbientWeatherDashboard:"
  },

  "AzureMonitor": {
    "ConnectionString": ""
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}

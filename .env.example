# Local development — copy to `.env` and adjust (never commit `.env`).

# PostgreSQL (matches docker-compose defaults unless overridden)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=AmbientWeatherDB
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Connection string for ASP.NET Core (User Secrets override this in dev)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=AmbientWeatherDB;Username=postgres;Password=change-me-local-only

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth0 backend JWT validation (use .NET User Secrets locally)
Authentication__Authority=https://example.auth0.test/
Authentication__Audience=https://ambient-weather-dashboard-api

# Auth0 frontend SPA config (public browser-safe values only)
VITE_AUTH0_DOMAIN=example.auth0.test
VITE_AUTH0_CLIENT_ID=example-spa-client-id
VITE_AUTH0_AUDIENCE=https://ambient-weather-dashboard-api
VITE_API_BASE_URL=

# Ambient Weather (Phase 6 — use User Secrets; never commit real keys)
AmbientWeather__ApplicationKey=

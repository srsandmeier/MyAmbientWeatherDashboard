# .env.prod.example
# Location: Root directory of the monorepo
# Copy to `.env` on the Oracle VM (gitignored) and fill in real values.
# See docs/ORACLE_DEPLOYMENT_PLAN.md for the full deployment plan.

# PostgreSQL container credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD={change-me-strong-password}
POSTGRES_DB=AmbientWeatherDB

# Connection strings consumed by the api/workers containers
ConnectionStrings__Postgres=Host=db;Port=5432;Database=AmbientWeatherDB;Username=postgres;Password={change-me-strong-password}
ConnectionStrings__Redis=cache:6379

# Auth0 API authentication (must match the values used by the frontend)
Authentication__Authority={auth0-domain}
Authentication__Audience={auth0-audience}

# CORS — must be the exact GitHub Pages origin (no path, no trailing slash)
Cors__AllowedOrigin=https://{github-username}.github.io

# Sent as the User-Agent contact header on outbound Ambient/public-provider API calls
UserAgent__Contact={your-contact-email}

# Restrict Kestrel host validation to the public sslip.io hostname
AllowedHosts={sslip-hostname}

# ASP.NET Core Data Protection key ring — mounted as a named volume (see docker-compose.prod.yml)
DataProtection__KeyRingPath=/keys
